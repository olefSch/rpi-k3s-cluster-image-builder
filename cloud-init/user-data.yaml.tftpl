hostname: ${NODE_HOSTNAME}
manage_etc_hosts: true

users:
  - name: pi
    groups: sudo
    shell: /bin/bash
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${SSH_PUBLIC_KEY}

runcmd:
  # dependencies
  - |
    apt-get update && apt-get install -y parted

  # prep ssd
  - |
    DISK="/dev/sda"
    PARTITION="/dev/sda1"
    MOUNT_POINT="/var/lib/rancher/k3s"

    echo "Checking for SSD at $DISK..."
    if lsblk $DISK >/dev/null 2>&1; then
      if ! blkid $PARTITION >/dev/null 2>&1; then
        echo "No filesystem found on $PARTITION. Wiping and formatting..."
        wipefs -a $DISK
        parted -s $DISK mklabel gpt
        parted -s $DISK mkpart primary ext4 0% 100%
        sleep 3
        mkfs.ext4 -F -L K3SDATA $PARTITION
      else
        echo "Filesystem already exists on $PARTITION. Skipping format."
      fi

      echo "Mounting SSD to $MOUNT_POINT..."
      mkdir -p $MOUNT_POINT
      if ! grep -q "$MOUNT_POINT" /etc/fstab; then
        echo "LABEL=K3SDATA $MOUNT_POINT ext4 defaults,noatime 0 2" >> /etc/fstab
      fi
      mount -a
    else
      echo "WARNING: No SSD detected at $DISK. K3s will use the SD card."
    fi

  # auto deploy manifests
  - |
    if [ "${NODE_ROLE}" = "master-init" ]; then
      echo "Setting up ArgoCD and Kube-VIP auto-deploy manifests..."
      mkdir -p /var/lib/rancher/k3s/server/manifests/
      cp /boot/firmware/k3s-manifests/argocd-helm.yaml /var/lib/rancher/k3s/server/manifests/
      cp /boot/firmware/k3s-manifests/argocd-app.yaml /var/lib/rancher/k3s/server/manifests/
      cp /boot/firmware/k3s-manifests/kube-vip-daemonset.yaml /var/lib/rancher/k3s/server/manifests/
    fi

  # install k3s
  - |
    if [ "${NODE_ROLE}" = "master-init" ]; then
      echo "Initializing new HA control plane..."
      curl -sfL https://get.k3s.io | K3S_TOKEN=${K3S_TOKEN} sh -s - server --cluster-init --tls-san ${VIP_IP}
    elif [ "${NODE_ROLE}" = "master-join" ]; then
      echo "Joining existing HA control plane..."
      curl -sfL https://get.k3s.io | K3S_TOKEN=${K3S_TOKEN} sh -s - server --server https://${VIP_IP}:6443
    elif [ "${NODE_ROLE}" = "worker" ]; then
      echo "Joining as worker node..."
      curl -sfL https://get.k3s.io | K3S_TOKEN=${K3S_TOKEN} sh -s - agent --server https://${VIP_IP}:6443
    else
      echo "ERROR: Unknown NODE_ROLE ${NODE_ROLE}"
      exit 1
    fi
